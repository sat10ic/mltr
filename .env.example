# MLTR Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# API Keys - Market Data
# ============================================================================
MLTR_MARKET_API_KEY=your_market_api_key_here
MLTR_MARKET_API_SECRET=your_market_api_secret_here

# Dhan API (if using)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# ============================================================================
# API Keys - News & Social
# ============================================================================
# NewsAPI
MLTR_NEWSAPI_KEY=your_newsapi_key_here

# Twitter API
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=mltr-bot

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================================================
# Database & Storage
# ============================================================================
# PostgreSQL / TimescaleDB (if using)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mltr
POSTGRES_USER=mltr_user
POSTGRES_PASSWORD=your_secure_password

# Redis (if using)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================================================================
# Cloud Storage (if using)
# ============================================================================
# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mltr-data

# Google Cloud
GCP_PROJECT_ID=your_gcp_project_id
GCP_BUCKET=mltr-data

# Azure
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string

# ============================================================================
# Vector Database (if using cloud)
# ============================================================================
# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================================================
# Authentication & Security
# ============================================================================
MLTR_JWT_SECRET=your_secret_jwt_key_here_use_strong_random_string
MLTR_JWT_ALGORITHM=HS256
MLTR_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin credentials (for dashboard/API)
MLTR_ADMIN_USERNAME=admin
MLTR_ADMIN_PASSWORD=change_this_secure_password

# ============================================================================
# Monitoring & Alerts
# ============================================================================
# Sentry
MLTR_SENTRY_DSN=your_sentry_dsn_here

# Email alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password
ALERT_EMAIL_TO=alerts@yourdomain.com

# ============================================================================
# Workflow Orchestration
# ============================================================================
# Prefect Cloud (if using)
PREFECT_API_KEY=your_prefect_api_key
PREFECT_WORKSPACE=your_workspace

# Airflow (if using)
AIRFLOW_HOME=/path/to/airflow
AIRFLOW_FERNET_KEY=your_fernet_key

# ============================================================================
# LLM & RAG
# ============================================================================
# OpenAI API (if using as fallback)
OPENAI_API_KEY=your_openai_api_key

# Hugging Face (for model downloads)
HUGGINGFACE_TOKEN=your_huggingface_token

# ============================================================================
# Development Settings
# ============================================================================
MLTR_ENV=development  # development, staging, production
MLTR_DEBUG=true
MLTR_LOG_LEVEL=INFO

# ============================================================================
# Other
# ============================================================================
PYTHONPATH=/home/user/mltr
