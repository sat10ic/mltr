# ==============================================================================
# Project-specific: Data & Models
# ==============================================================================
# Raw data (too large for Git)
data/raw/**
!data/raw/.gitkeep

# Processed data (use DVC instead)
data/processed/**
!data/processed/.gitkeep

# Model artifacts (use MLflow/DVC)
data/models/**
!data/models/.gitkeep

# MLflow tracking
data/mlruns/
mlruns/

# DVC
.dvc/tmp/
.dvc/cache/

# Outputs (generated reports, signals)
data/outputs/**
!data/outputs/.gitkeep

# Backups
data/backups/**
*.db-journal
*.db-wal

